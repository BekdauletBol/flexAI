# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (or GitHub PAT for GitHub Models)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model
OPENAI_MODEL=openai/gpt-4.1

# Groq API Key for Whisper transcription (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# --- Deployment & Security ---

# Telegram webhook secret token (required for webhook mode)
TELEGRAM_BOT_API_SECRET_TOKEN=your_secret_token_here

# Webhook domain (e.g. https://your-bot.com) — omit for long polling
WEBHOOK_DOMAIN=

# Admin Telegram ID for /stats command
ADMIN_TELEGRAM_ID=

# Maximum number of users (hard cap)
MAX_USERS=30000

# --- Optional features ---

# Limit bot access to specific Telegram user ID (testing only — overrides MAX_USERS)
ALLOWED_USER_ID=

# Google Maps API Key (for Places search, reverse geocoding, directions)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Weather API (OpenWeatherMap current weather by default)
WEATHERAPI=your_weather_api_key_here
WEATHER_BASE_URL=

# Telegram Mini App Public URL (e.g. Railway, Render, Ngrok HTTPS URL)
WEBAPP_URL=your_public_webapp_url_here

# Port for Express server
PORT=3000

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Postgres (Docker only — not used by the app yet)
POSTGRES_PASSWORD=changeme
